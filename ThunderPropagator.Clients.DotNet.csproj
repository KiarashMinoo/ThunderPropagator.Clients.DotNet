<Project Sdk="Microsoft.NET.Sdk">

    <!-- $(BuildingBlocksPackageId) now comes from ThunderPropagator.SharedBuild's
         Shared.PackageIds.props (imported via SharedProps.props at the repo root) —
         version is centrally managed in Directory.Packages.props. -->
    <ItemGroup>
        <PackageReference Include="$(BuildingBlocksPackageId)" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="Tests\**" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Remove="Tests\**" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Tests\**" />
    </ItemGroup>

</Project>
